package com.sbi.controller;


import java.io.BufferedInputStream;
import java.io.BufferedOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.file.AtomicMoveNotSupportedException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.text.DecimalFormat;
import java.util.Properties;
import java.util.Vector;

import org.springframework.stereotype.Service;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.core.Logger;

import com.jcraft.jsch.ChannelSftp;
import com.jcraft.jsch.JSch;
import com.jcraft.jsch.SftpATTRS;
import com.jcraft.jsch.SftpException;
import com.sbi.config.ExtractProperties;

@Service
public class sftpService {

	private final static Logger logger = (Logger) LogManager.getLogger(sftpService.class);

	static String sftpHost = ExtractProperties.getInstance().getProperty("sftp.host");
	static String sftpPort = ExtractProperties.getInstance().getProperty("sftp.port");
	static String sftpUser = ExtractProperties.getInstance().getProperty("sftp.user");
	static String sftpPassword = ExtractProperties.getInstance().getProperty("sftp.password");
	static String remoteDir = ExtractProperties.getInstance().getProperty("sftp.remoteDir");
	static String localDir = ExtractProperties.getInstance().getProperty("sftp.localDir");
	static String fileFormat = ExtractProperties.getInstance().getProperty("file.extension");
	
	private static final int BUFFER_SIZE = 64 * 1024;
	private static final long PROGRESS_INTERVAL = 100L * 1024L * 1024L;
	private static final String MANIFEST_FILE = ".sftp-download-manifest.properties";
	
	public void pullFilesFromSFG() {
		com.jcraft.jsch.Session session = null;
		ChannelSftp channelSftp = null;

		try {
			// 1. Setup JSch Session
			JSch jsch = new JSch();

			session = jsch.getSession(sftpUser, sftpHost, Integer.parseInt(sftpPort));
			session.setPassword(sftpPassword);
			logger.info("Connecting to SFG server: " + sftpHost + ":" + sftpPort);

			// 2. Configure Session (Skip host key checking for internal networks, or set known_hosts for production)
			Properties config = new Properties();
			config.put("StrictHostKeyChecking", "no");
			session.setConfig(config);

			// 3. Connect
			session.connect(10000); // 10s timeout
			logger.info("SSH session connected successfully.");
			channelSftp = (ChannelSftp) session.openChannel("sftp");
			channelSftp.connect(5000); // 5s timeout
			logger.info("Connected to SFG Server successfully.");

			// 4. Download all files from remote folder to local INPUT folder
			try {
				downloadFiles(channelSftp);
			} catch (Exception e) {
				logger.error("Error downloading files from SFG", e);
			}
			logger.info("SFG file download process completed.");
		} catch (Exception e) {
			e.printStackTrace();
			throw new RuntimeException("Failed to download files from SFTP", e);
		} finally {
			// 5. Cleanup Resources


			if (channelSftp != null && channelSftp.isConnected()) {
				channelSftp.exit();
				channelSftp.disconnect();
			}
			if (session != null && session.isConnected()) {
				session.disconnect();
			}
		}
	}

	private void downloadFiles(ChannelSftp channelSftp) throws SftpException {

		// Construct remote path (Adjust pattern based on SFG server structure)
		String remotePath = remoteDir; //INPUT
		logger.info("remotePath :  "+remotePath);

		File localDirectory = new File(localDir);
		logger.info("localDirectory :  "+localDirectory);
		if (!localDirectory.exists()) {
			boolean created = localDirectory.mkdirs();
			if (!created && !localDirectory.exists()) {
				logger.error("Unable to create local directory: " + localDirectory.getAbsolutePath());
				return;
			}
			logger.info("Created local directory: " + localDirectory.getAbsolutePath());
		}

		Properties manifest = loadManifest(localDirectory);

		Vector<ChannelSftp.LsEntry> files;

		try {
			files = channelSftp.ls(remotePath);
		} catch (SftpException e) {
			logger.error("Unable to list remote directory: " + remotePath, e);
			return;
		}
		try {

			if (files == null || files.isEmpty()) {
				logger.info("No files found in remote directory: " + remotePath);
				return;
			}

			logger.info("Found " + files.size() + " entries");

			int successCount = 0;
			int skippedCount = 0;
			int failedCount = 0;

			for (ChannelSftp.LsEntry entry : files) {
				String fileName = entry.getFilename();
				if (".".equals(fileName) || "..".equals(fileName)) {
					continue;
				}

				if (entry.getAttrs().isDir()) {
					logger.info("Skipping directory: " + fileName);
					continue;
				}

				if (!fileName.toLowerCase().endsWith(fileFormat)) {
					logger.info("Skipping non-ZIP file: " + fileName);
					continue;
				}
				long remoteFileSize = entry.getAttrs().getSize();

				long remoteModifiedTime = entry.getAttrs().getMTime();

				String manifestKey = createManifestKey(fileName, remoteFileSize, remoteModifiedTime);

				if (manifest.containsKey(manifestKey)) {
					logger.info("Already downloaded. Skipping: " + fileName);
					skippedCount++;
					continue;
				}

				try {
					boolean downloaded = downloadSingleFile(channelSftp, entry, localDirectory);

					if (downloaded) {
						manifest.setProperty(manifestKey, "DOWNLOADED");
						saveManifest(localDirectory, manifest);
						successCount++;
					} else {
						failedCount++;
					}

				} catch (Exception e) {
					failedCount++;
					logger.error("Failed to download file: " + fileName, e);
				}
			}
			logger.info("Completed. Success=" + successCount + ", Skipped=" + skippedCount
					+ ", Failed=" + failedCount);

		} catch (Exception e) {
			System.err.println("Error downloading files: " + e.getMessage());
		}
	}

	private Properties loadManifest(File localDirectory) {
		Properties properties = new Properties();
		File manifestFile = new File(localDirectory, MANIFEST_FILE);
		if (!manifestFile.exists()) {
			return properties;
		}
		try (FileInputStream inputStream = new FileInputStream(manifestFile)) {
			properties.load(inputStream);
			logger.info("Loaded download manifest: " + manifestFile);
		} catch (Exception e) {

			logger.warn("Unable to load download manifest: " + manifestFile, e);
		}
		return properties;
	}

	private String createManifestKey(String fileName, long fileSize, long modifiedTime) {
		return fileName + "|" + fileSize + "|" + modifiedTime;
	}


	private void saveManifest(File localDirectory, Properties properties) {
		File manifestFile = new File(localDirectory, MANIFEST_FILE);
		File tempManifest = new File(localDirectory, MANIFEST_FILE + ".tmp");
		try {
			try (FileOutputStream outputStream = new FileOutputStream(tempManifest)) {
				properties.store(outputStream, "SFTP Download Manifest");
			}
			try {
				Files.move(tempManifest.toPath(), manifestFile.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
			} catch (AtomicMoveNotSupportedException e) {
				Files.move(tempManifest.toPath(), manifestFile.toPath(), StandardCopyOption.REPLACE_EXISTING);
			}
		} catch (Exception e) {
			logger.error("Unable to save download manifest: " + manifestFile, e);
		}
	}

	private String addTimestamp(String fileName, String timestamp) {
		int dotIndex = fileName.lastIndexOf('.');
		if (dotIndex > 0) {
			String name = fileName.substring(0, dotIndex);
			String extension = fileName.substring(dotIndex);
			return name + "_" + timestamp + extension;
		}
		return fileName + "_" + timestamp;
	}
	
	// New Changes
	private static String remotePathForFile(String remoteDir, String fileName) {
		//return remoteDir + "/" + lcpc + "/"+inputFolder+"/" + fileName;
		return remoteDir + "/" + fileName;
	}

	private String formatBytes(long bytes) {
		if (bytes < 1024)  return bytes + " B";
		
		double value = bytes / 1024.0;
		if (value < 1024)  return new DecimalFormat("0.00").format(value) + " KB";
		
		value = value / 1024.0;
		if (value < 1024)  return new DecimalFormat("0.00").format(value) + " MB";
		
		value = value / 1024.0;
		return new DecimalFormat("0.00").format(value) + " GB";
	}

	private String formatDuration(long milliseconds) {
		long seconds = milliseconds / 1000;
		long hours = seconds / 3600;
		seconds = seconds % 3600;
		long minutes = seconds / 60;
		seconds = seconds % 60;
		return String.format("%02d:%02d:%02d", hours, minutes, seconds);
	}

	private boolean downloadSingleFile(ChannelSftp channelSftp, ChannelSftp.LsEntry entry,
			File localDirectory) throws Exception {

		String fileName = entry.getFilename();

		long expectedFileSize = entry.getAttrs().getSize();

		
		String timestamp = String.valueOf(System.currentTimeMillis());
		String timestampedFileName = addTimestamp(fileName, timestamp);

		Path finalFile = Paths.get(localDirectory.getAbsolutePath(), timestampedFileName);

		Path tempFile = Paths.get(localDirectory.getAbsolutePath(), timestampedFileName + ".part");
		
		// New Change
		String remoteFile = remotePathForFile(remoteDir, fileName);

		logger.info("------------------------------------------");

		logger.info("Starting download");
		logger.info("Remote file: " + remoteFile);
		logger.info("Local file: " + finalFile);
		logger.info("Expected size: " + formatBytes(expectedFileSize));

		if (Files.exists(tempFile)) {
			logger.warn("Removing incomplete .part file: " + tempFile);
			Files.delete(tempFile);
		}

		long startTime = System.currentTimeMillis();
		long totalBytesRead = 0;
		long lastLoggedBytes = 0;

		try (InputStream inputStream = new BufferedInputStream(channelSftp.get(remoteFile), BUFFER_SIZE);
				OutputStream outputStream = new BufferedOutputStream(new FileOutputStream(tempFile.toFile()), BUFFER_SIZE)) {
			byte[] buffer = new byte[BUFFER_SIZE];
			int bytesRead;

			while ((bytesRead = inputStream.read(buffer)) != -1) {
				outputStream.write(buffer, 0, bytesRead);
				totalBytesRead += bytesRead;
			
				if (totalBytesRead - lastLoggedBytes >= PROGRESS_INTERVAL) {
					long elapsed = System.currentTimeMillis() - startTime;
					double percentage = 0;
					if (expectedFileSize > 0) {
						percentage = (totalBytesRead * 100.0) / expectedFileSize;
					}
					logger.info("Downloading " + fileName + " : " + formatBytes(totalBytesRead) + " / "
							+ formatBytes(expectedFileSize) + " (" + new DecimalFormat("0.00").format(percentage)
							+ "%)" + ", elapsed=" + formatDuration(elapsed));
					lastLoggedBytes = totalBytesRead;
				}
			}
		}
		
		if (totalBytesRead != expectedFileSize) {
			logger.error("File size mismatch for: " + fileName + ". Expected=" + expectedFileSize + ", Actual=" + totalBytesRead);
			
			try {
				Files.deleteIfExists(tempFile);
			} catch (Exception deleteException) {
				logger.warn("Unable to delete incomplete file: " + tempFile, deleteException);
			}
			return false;
		}
		
		SftpATTRS currentEntry = null;
		try {
			currentEntry = getRemoteFileEntry(channelSftp, remoteDir, fileName);
		} catch (Exception e) {
			logger.error("Unable to verify remote file after download: " + fileName, e);
		}
		if (currentEntry != null) {
			long currentSize = currentEntry.getSize();
			if (currentSize != expectedFileSize) {
				logger.error("Remote file changed during download: " + fileName);
				Files.deleteIfExists(tempFile);
				return false;
			}
		}
		
		try {
			Files.move(tempFile, finalFile, StandardCopyOption.ATOMIC_MOVE);
		} catch (AtomicMoveNotSupportedException e) {
			
			Files.move(tempFile, finalFile, StandardCopyOption.REPLACE_EXISTING);
		}
		long elapsed = System.currentTimeMillis() - startTime;
		
		double speedMBps = 0;
		if (elapsed > 0) {
			speedMBps = (totalBytesRead / 1024.0 / 1024.0) / (elapsed / 1000.0);
		}
		logger.info("Successfully downloaded: " + fileName);
		logger.info("Saved as: " + finalFile.getFileName());
		logger.info("Size: " + formatBytes(totalBytesRead));
		logger.info("Time taken: " + formatDuration(elapsed));
		logger.info("Average speed: " + new DecimalFormat("0.00").format(speedMBps) + " MB/s");
		return true;
	}

	private SftpATTRS getRemoteFileEntry(ChannelSftp channelSftp, String remoteDir, String fileName) throws SftpException {
		// New Change
		String remotePath = remotePathForFile(remoteDir, fileName);
		return channelSftp.stat(remotePath);
	}
}
